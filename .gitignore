# ═══════════════════════════════════════════════════════════════════════════
#  FanFever: Modular Monolith — .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# Modular Monolith & Microservices (Recursive check)
**/node_modules/
**/__pycache__/
**/*.py[cod]

# ── Build & Distribution ───────────────────────────────────────────────────
dist/
build/
out/
.next/
.output/
release-builds/
/MyApp-win32-x64/
/MyApp-linux-x64/
/MyApp-darwin-x64/

# ── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*

# ── OS & IDE Artifacts ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo

# ── Python / ML (Sidecar) ──────────────────────────────────────────────────
env/
venv/
.venv/
**/venv/
**/env/
*.pyd
*.pyo
.pytest_cache/
.mypy_cache/

# Large Model Binaries (Use Git LFS for these in production)
*.pkl
*.h5
*.pt
*.pth
*.onnx
*.bin
**/model/
**/weights/

# ── Databases ──────────────────────────────────────────────────────────────
data/db/
mongod.lock
*.bson
*.dbpath

# ── Certificates ────────────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12

# ── Vite ────────────────────────────────────────────────────────────────────
.vite/
vite.config.js.timestamp-*

# ── Scratch / Temp ──────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
repomix-output.*
