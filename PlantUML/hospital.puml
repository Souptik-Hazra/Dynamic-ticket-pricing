@startuml
title UML Class Diagram - Hospital Management System

'================ ENUM =================
enum PaymentStatus {
    Pending
    Paid
    Cancelled
}

'================ INTERFACE =================
interface Payable {
    +makePayment()
}

'================ ABSTRACT CLASS =================
abstract class Person {
    -personId : int
    -name : String
    -age : int
    -phone : String
    +getDetails()
}

'================ MAIN CLASSES =================

class Employee {
    -employeeId : int
    -salary : double
    +getDetails()
}

class Patient {
    -patientId : int
    -bloodGroup : String
    +register()
    +discharge()
}

class Appointment {
    -appointmentId : int
    -date : Date
    -time : String
    +schedule()
    +cancel()
}

class MedicalRecord {
    -recordId : int
    -diagnosis : String
    -treatment : String
    +updateRecord()
}

class Bill {
    -billId : int
    -amount : double
    -tax : double
    /totalAmount : double
    +generateBill()
}

class Payment {
    -paymentId : int
    -amount : double
    -status : PaymentStatus
    +makePayment()
}

class Hospital {
    {static} hospitalName : String
    {static} +getHospitalInfo()
}

'================ SUB CLASSES =================

class Doctor {
    -specialization : String
    +prescribeMedicine()
}

class Nurse {
    +assistDoctor()
}

class Receptionist {
    +bookAppointment()
}

class InPatient {
    -roomNo : int
}

class OutPatient {
    -visitType : String
}

class CardPayment {
    -cardNumber : String
}

class CashPayment {
    -counterNo : int
}

class Treatment {
    -treatmentDate : Date
    -remarks : String
}

'================ INHERITANCE =================

Person <|-- Employee
Person <|-- Patient

Employee <|-- Doctor
Employee <|-- Nurse
Employee <|-- Receptionist

Patient <|-- InPatient
Patient <|-- OutPatient

Payment <|-- CardPayment
Payment <|-- CashPayment

Payment ..|> Payable

'================ AGGREGATION =================

Doctor "1" o-- "0..*" Patient
Receptionist "1" o-- "0..*" Appointment

'================ COMPOSITION =================

Patient "1" *-- "1" MedicalRecord
Patient "1" *-- "0..*" Bill
Bill "1" *-- "1..*" Payment

'================ ASSOCIATION =================

Patient "1" -- "0..*" Appointment
Appointment "1" -- "1" Doctor

Doctor "1" -- "0..*" Treatment
Patient "1" -- "0..*" Treatment

'================ DEPENDENCY =================

Doctor ..> MedicalRecord : updates

'================ NOTE =================

note right of Patient
Patient must register
before booking appointment.
end note

@enduml