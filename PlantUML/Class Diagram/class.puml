@startuml
title UML Class Diagram - Property Tax Management System (With Subclasses)

'================ SUPER CLASSES =================

class User {
    -userId : int
    -name : String
    -email : String
    -password : String
    +login()
    +logout()
}

class Property {
    -propertyId : int
    -address : String
    -area : double
    +calculateTax()
}

class Payment {
    -paymentId : int
    -amount : double
    -paymentDate : Date
    -status : String
    +makePayment()
}

'================ SUB CLASSES =================

class Admin {
    +generateReport()
    +manageUsers()
}

class Citizen {
    +viewTaxDetails()
    +payTax()
}

class ResidentialProperty {
    -houseType : String
}

class CommercialProperty {
    -businessType : String
}

class OnlinePayment {
    -transactionId : String
}

class OfflinePayment {
    -counterId : String
}

class CreditCardPayment {
    -cardNumber : String
}

class UPI {
    -upiId : String
}

class Receipt {
    -receiptNo : int
    -date : Date
    +downloadReceipt()
}

class Report {
    -reportId : int
    -type : String
    +generate()
}

class Notification {
    -message : String
    +sendEmail()
    +sendSMS()
}

'================ INHERITANCE =================

User <|-- Admin
User <|-- Citizen

Property <|-- ResidentialProperty
Property <|-- CommercialProperty

Payment <|-- OnlinePayment
Payment <|-- OfflinePayment

OnlinePayment <|-- CreditCardPayment
OnlinePayment <|-- UPI

'================ AGGREGATION =================

Citizen "1" o-- "0..*" Property

'================ COMPOSITION =================

Property "1" *-- "0..*" Payment
Payment "1" *-- "1" Receipt

'================ ASSOCIATION =================

Admin "1" -- "0..*" Report
Payment "1" -- "1" Notification

@enduml