		{
			"name": "5. Stress Testing (Expert)",
			"item": [
				{
					"name": "Rapid Price Refresh",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Verify Price Hunting Throttle\", function () {",
									"    if (pm.response.code === 429) {",
									"        console.warn(\"🎯 Rate limiter triggered! system defended against price hunting.\");",
									"    } else {",
									"        pm.expect(pm.response.code).to.equal(200);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/events/{{current_event_id}}/dynamic-prices",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"events",
								"{{current_event_id}}",
								"dynamic-prices"
							]
						},
						"description": "Run this in Collection Runner with 0 delay to test the API Gateway Rate Limiter and the Organizer Service 'Anti-Price Hunting' guard."
					},
					"response": []
				},
				{
					"name": "Concurrent Purchase Simulation",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"eventId\": \"{{current_event_id}}\",\n    \"categoryName\": \"standard\",\n    \"quantity\": 1,\n    \"customerName\": \"Load Tester\",\n    \"customerEmail\": \"load_{{$randomInt}}@test.com\"\n}",
