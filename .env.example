# ── FanFever Unified Monolith Environment ──

# 🌐 Server Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=15m
REFRESH_EXPIRE=7d

# 💾 Database (Infrastructure)
MONGODB_URI=mongodb://mongodb:27017/fanfever
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
REDIS_URL=redis://redis:6379

# 🧠 AI & Machine Learning
ML_SERVICE_URL=http://localhost:5000
PYTHON_PATH=python3
ML_AGGREGATION_THRESHOLD=3
ML_CLIP_NORM=15.0
ML_DP_EPSILON=0.05

# 📧 Communication & Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM="FanFever Support <support@fanfever.local>"

# 🛡️ Security Speed-Bumps
MAX_WORKER_MEMORY_MB=1024
BOT_SHIELD_ENABLED=true
RATE_LIMIT_AUTH=20
RATE_LIMIT_PURCHASE=10

# 🎨 Frontend (Vite)
VITE_API_URL=/api
VITE_WS_URL=/api/ws
