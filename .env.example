# ===========================================
# Dynamic Ticket Pricing - Environment Template
# ===========================================

# Node.js Express Backend Configuration
PORT=3001
NODE_ENV=development
BACKEND_URL=http://localhost:3001
MONGODB_URI=mongodb://localhost:27017/dynamic-ticket-pricing
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Python FastAPI ML Microservice
ML_PORT=5000
ML_API_URL=http://localhost:5000

# React Frontend Configuration (Vite)
VITE_API_URL=http://localhost:3001/api
VITE_ML_API_URL=http://localhost:5000

# Google Gemini GenAI API Key (gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173

# Cache & Message Queue Config (Optional)
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
