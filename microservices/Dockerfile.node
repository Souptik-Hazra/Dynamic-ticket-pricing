# Common Dockerfile for all Node.js microservices
FROM node:20-alpine AS build

# This build arg determines which service we are building
ARG SERVICE_PATH

WORKDIR /app

# Copy the shared directory if it exists (for inter-service code)
COPY ./shared ./shared

# Copy the specific service package files
COPY ./${SERVICE_PATH}/package*.json ./${SERVICE_PATH}/

# Install dependencies in the service directory
WORKDIR /app/${SERVICE_PATH}
RUN npm install

# Copy the rest of the service source
COPY ./${SERVICE_PATH} .

# Runtime stage
FROM node:20-alpine AS runtime

ARG SERVICE_PATH
ARG PORT

WORKDIR /app/${SERVICE_PATH}

# Copy node_modules and code from build stage
COPY --from=build /app/shared /app/shared
COPY --from=build /app/${SERVICE_PATH} .

# Set environment
ENV PORT=${PORT}
EXPOSE ${PORT}

USER node

# Dynamic CMD to start the service
CMD ["node", "index.js"]
