{
  "name": "dynamic-ticket-pricing",
  "private": true,
  "main": "electron-main.cjs",
  "version": "1.0.1",
  "type": "module",
  "description": "Dynamic Ticket Pricing System with ML-powered price predictions. Frontend built with React and Vite, Electron integration.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "vite",
    "test": "echo \"No tests specified\" && exit 0",
    "electron:dev": "vite build && npx electron .",
    "electron:serve": "npx electron .",
    "package": "electron-builder",
    "build-and-package": "npm run build && npm run package"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.4",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.6.0",
    "electron-builder": "^22.14.13",
    "eslint": "^10.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "productName": "FanFeverTickets",
    "compression": "maximum",
    "icon": "icon.ico",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "backend/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Souptik-Hazra/Dynamic-ticket-pricing"
  },
  "bugs": {
    "url": "https://github.com/Souptik-Hazra/Dynamic-ticket-pricing/issues"
  },
  "homepage": "https://github.com/Souptik-Hazra/Dynamic-ticket-pricing#readme"
}
