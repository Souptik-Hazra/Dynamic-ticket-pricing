{
  "name": "fan-fever-tickets",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FanFever - High-Performance AI-Powered Dynamic Ticket Pricing & Bot-Shield Platform",
  "author": "Souptik Hazra",
  "homepage": "https://fanfever.local",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --host",
    "monolith:dev": "cd modular-monolith && npm run dev",
    "start": "concurrently -n \"frontend,monolith\" -c \"cyan,green\" \"npm run dev\" \"npm run monolith:dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "vite build && npx electron .",
    "electron:serve": "npx electron .",
    "package": "electron-builder",
    "kill:ports": "powershell -Command \"$ports = @(5173, 4000, 5000); foreach ($p in $ports) { try { $conn = Get-NetTCPConnection -LocalPort $p -ErrorAction SilentlyContinue; if ($conn) { $conn | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue } } } catch {} }; exit 0\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.2",
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "kill-port": "^2.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "vite": "^8.0.8",
    "vite-plugin-mkcert": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.fanfever.tickets",
    "productName": "FanFeverTickets",
    "compression": "maximum",
    "icon": "public/favicon.png",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "public/icon.png"
    ]
  }
}
