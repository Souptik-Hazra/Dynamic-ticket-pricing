# ===========================================
# Dynamic Ticket Pricing - Environment Config
# ===========================================

# DevOps Optimization: Only start core services plus ML by default
COMPOSE_PROFILES=core,ml
DOTENVX_LOG=error

# API Gateway (frontend talks to this)
BACKEND_URL=http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dynamic-ticket-pricing

# JWT
JWT_SECRET=SouptikHazraSecretKey
JWT_EXPIRE=7d

# ML Model Configuration
ML_PORT=5000
ML_API_URL=http://localhost:5000
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0

# Frontend Configuration (Vite uses VITE_ prefix)
# VITE_API_URL=http://localhost:3001/api
# VITE_ML_API_URL=http://localhost:5000

# CORS Configuration
ALLOWED_ORIGINS=*

# Microservice Ports
PORT_API_GATEWAY=3001
PORT_AUTHENTICATION_SERVICE=4001
PORT_USER_SERVICE=4002
PORT_ADMIN_SERVICE=4003
PORT_PAYMENT_SERVICE=4004
PORT_CACHE_SERVICE=4005
PORT_EMAIL_SERVICE=4007
PORT_NOTIFICATION_SERVICE=4009
PORT_WEBSOCKET_SERVICE=4010
PORT_ANALYTICS_SERVICE=4011
PORT_SUBSCRIPTION_SERVICE=4012
PORT_ORGANIZER_SERVICE=4013
PORT_QR_SERVICE=4014
PORT_SCANNER_SERVICE=4015
PORT_WALLET_SERVICE=4016

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
ADMIN_SERVICE_URL=http://localhost:4003
PAYMENT_SERVICE_URL=http://localhost:4004
CACHE_SERVICE_URL=http://localhost:4005

EMAIL_SERVICE_URL=http://localhost:4007

NOTIFICATION_SERVICE_URL=http://localhost:4009
WEBSOCKET_SERVICE_URL=http://localhost:4010
ANALYTICS_SERVICE_URL=http://localhost:4011
SUBSCRIPTION_SERVICE_URL=http://localhost:4012
ORGANIZER_SERVICE_URL=http://localhost:4013
QR_SERVICE_URL=http://localhost:4014
SCANNER_SERVICE_URL=http://localhost:4015
WALLET_SERVICE_URL=http://localhost:4016

# Deployment Config
# FRONTEND_URL=http://localhost:5173
# VITE_API_URL=http://localhost:3001/api
# PROXY MODE: Using relative /api paths to leverage Vite proxy
VITE_API_URL=/api

# Redis (uncomment when Redis is running)
REDIS_URL=redis://localhost:6379

# RabbitMQ (uncomment when RabbitMQ is running)
RABBITMQ_URL=amqp://localhost

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
