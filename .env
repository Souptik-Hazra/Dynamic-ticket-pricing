# 🌐 FanFever - UNIVERSAL CONFIGURATION (SYNCED)
# ──────────────────────────────────────────────────────────

# ── Monolith Core ──
PORT=4000
NODE_ENV=development
JWT_SECRET=SouptikHazraSecretKey
JWT_EXPIRE=7d
PYTHON_PATH=python

# ── Resource Management ──
CPU_CLUSTERS=0
MAX_WORKER_MEMORY_MB=1024

# ── Databases ──
MONGODB_URI=mongodb://localhost:27017/dynamic-ticket-pricing
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Redis (Cache & Session) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AI & ML Parameters ──
ML_PORT=5000
ML_SERVICE_URL=http://localhost:5000
ML_DP_EPSILON=0.05
ML_CLIP_NORM=15.0
ML_AGGREGATION_THRESHOLD=1

# ── Frontend (Vite) ──
VITE_PORT=5173
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:4000/api/ws
VITE_WS_PROXY_TARGET=http://localhost:4000
VITE_APP_ENV=development
VITE_ENABLE_ANALYTICS=true

# ── Communication ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Security ──
ALLOWED_ORIGINS=*
RATE_LIMIT_AUTH=20
RATE_LIMIT_PURCHASE=10
RATE_LIMIT_GENERAL=120
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1


# Vite
VITE_WS_PROXY_TARGET='http://localhost:4000';
