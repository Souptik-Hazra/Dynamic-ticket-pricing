# 🌐 FanFever - UNIVERSAL CONFIGURATION (SYNCED)
# ──────────────────────────────────────────────────────────
# This single file replaces .env, .env.example, and .env.example.production.
# Uncomment or modify the variables below depending on your environment.

# ── 1. CORE ENVIRONMENT ────────────────────────────────────
# Use 'development' for local runs, 'production' for deployment.
NODE_ENV=development
# NODE_ENV=production
PORT=4000
PYTHON_PATH=python

# ── 2. SECURITY ────────────────────────────────────────────
JWT_SECRET=SouptikHazraSecretKey
# In production, use a strong, randomly generated string:
# JWT_SECRET=your_super_secret_production_key_change_this
JWT_EXPIRE=7d
REFRESH_EXPIRE=7d

ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://yourdomain.com
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1

# Rate Limiting (Requests per Window)
RATE_LIMIT_AUTH=20
RATE_LIMIT_PURCHASE=10
RATE_LIMIT_GENERAL=120
BOT_SHIELD_ENABLED=true

# ── 3. RESOURCE MANAGEMENT (CLUSTERING) ────────────────────
# Number of CPU cores to utilize (0 = auto-detect all)
CPU_CLUSTERS=0
# Max heap memory before worker recycles (in MB)
MAX_WORKER_MEMORY_MB=1024

# ── 4. DATABASES ───────────────────────────────────────────
# MongoDB
MONGODB_URI=mongodb://localhost:27017/dynamic-ticket-pricing
# For Docker Production:
# MONGODB_URI=mongodb://mongodb:27017/fanfever

# Neo4j Graph DB
NEO4J_URI=bolt://localhost:7687
# For Docker Production:
# NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
# For Docker Production:
# REDIS_URL=redis://redis:6379

# ── 5. AI & ML PARAMETERS ──────────────────────────────────
ML_PORT=5000
ML_SERVICE_URL=http://localhost:5000
# AI Differential Privacy Epsilon (Lower = more privacy, less accuracy)
ML_DP_EPSILON=0.05
# Weight Clipping Norm (Stability threshold)
ML_CLIP_NORM=15.0
# Minimum participating nodes for Federated Aggregation
ML_AGGREGATION_THRESHOLD=1


# ── 7. FRONTEND (VITE) ─────────────────────────────────────
VITE_PORT=5173
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:4000/api/ws
VITE_WS_PROXY_TARGET=http://localhost:4000
VITE_APP_ENV=development
VITE_ENABLE_ANALYTICS=true

# ── 8. ALIASES (Backward Compatibility) ────────────────────
API_URL=http://localhost:4000/api/v1
ORGANIZER_SERVICE_URL=http://localhost:4000/api/v1
AUTH_SERVICE_URL=http://localhost:4000/api/v1