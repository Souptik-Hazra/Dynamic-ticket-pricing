# 🌐 FanFever Modular Monolith Configuration
# Use this template for production deployment.
# Copy this to .env and fill in your actual credentials.

# ── Server Config ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
JWT_SECRET=YourSuperSecretKeyChangeMe
PYTHON_PATH=python

# ── Resource Management (Clustering) ───────────────────────────────────────
# Number of CPU cores to utilize (0 = auto-detect all)
CPU_CLUSTERS=0
# Max heap memory before worker recycles (in MB)
MAX_WORKER_MEMORY_MB=1024

# ── Databases ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/dynamic-ticket-pricing
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
REDIS_URL=redis://localhost:6379

# ── AI & ML Model ──────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:5000
# AI Differential Privacy Epsilon (Lower = more privacy, less accuracy)
ML_DP_EPSILON=0.05
# Weight Clipping Norm (Stability threshold)
ML_CLIP_NORM=15.0
# Minimum participating nodes for Federated Aggregation
ML_AGGREGATION_THRESHOLD=3

# ── Communication ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Security ───────────────────────────────────────────────────────────────
# Rate Limiting (Requests per Window)
RATE_LIMIT_AUTH=20
RATE_LIMIT_PURCHASE=10
RATE_LIMIT_GENERAL=120
